{
  "name": "knitting",
  "summary": "Knitters knit clothes to order.",
  "description": "Knitters knit jumpers, cardigans, scarves, hats and socks to the wearer's measure, and hand them over in person or ship them.",
  "status": "live",
  "icon": "yarn",
  "number": 1,
  "roles": [
    { "role": "knitter", "listings": "offers" },
    { "role": "client", "listings": "requests" }
  ],
  "listing": {
    "description": {
      "piece": "text",
      "ask": { "label": "About", "long": true, "as": { "knitter": { "question": "What do you knit, and how?" }, "client": { "question": "What would you like knitted?" } } }
    },
    "kind": {
      "piece": "choice",
      "values": ["jumper", "cardigan", "scarf", "hat", "socks"],
      "several": true,
      "ask": { "label": "Kind", "as": { "knitter": { "question": "What do you knit?" }, "client": { "question": "What would you like knitted?" } } }
    },
    "wearer": { "piece": "choice", "values": ["women", "men", "children"], "several": true, "ask": { "label": "For", "question": "Who is it for?", "labels": { "children": "children and babies" } } },
    "size": {
      "piece": "choice",
      "values": ["xs", "s", "m", "l", "xl"],
      "several": true,
      "when": { "wearer": ["women", "men"], "kind": ["jumper", "cardigan"] },
      "ask": { "label": "Size", "question": "Which sizes?", "labels": { "xs": "XS", "s": "S", "m": "M", "l": "L", "xl": "XL" } }
    },
    "age": {
      "piece": "number",
      "unit": "years",
      "several": true,
      "when": { "wearer": ["children"] },
      "ask": { "label": "Age", "question": "How old is the child?", "as": { "knitter": { "question": "Which ages do you knit for?", "start": { "range": true } } } }
    },
    "chest": { "piece": "number", "unit": "centimetres", "when": { "kind": ["jumper", "cardigan"] }, "ask": { "label": "Chest", "question": "How big is the wearer's chest?", "hint": "Round its widest part, in centimetres." } },
    "footLength": { "piece": "number", "unit": "centimetres", "when": { "kind": ["socks"] } },
    "yarns": { "piece": "text", "several": true, "ask": { "label": "Yarns", "hint": "Such as merino, alpaca or cotton." } },
    "price": {
      "piece": "price",
      "per": ["item", "hour"],
      "ask": {
        "label": "Price",
        "as": {
          "knitter": { "question": "What do you charge?", "hint": "Every price you charge, packs included, such as 35 a pair of socks and 90 for three pairs." },
          "client": { "label": "Budget", "question": "What would you pay at most?" }
        }
      }
    },
    "deposit": { "piece": "price", "roles": ["knitter"], "ask": { "label": "Deposit", "question": "What do you ask for before you start?" } },
    "spots": { "piece": "number", "roles": ["knitter"], "ask": { "label": "Orders at once", "question": "How many orders can you take at once?", "hint": "0 when you are full." } },
    "days": { "piece": "number", "unit": "days", "roles": ["knitter"], "ask": { "label": "Days to knit", "question": "How many days does an order take?", "start": { "range": true } } },
    "due": { "piece": "date", "roles": ["client"], "ask": { "label": "Needed by", "question": "When do you need it by?", "start": { "way": "until" } } },
    "handover": { "piece": "choice", "values": ["in-person", "shipped"], "several": true, "ask": { "label": "Handover", "question": "How is it handed over?" } },
    "area": {
      "piece": "place",
      "when": { "handover": ["in-person"] },
      "ask": {
        "label": "Area",
        "as": {
          "knitter": { "question": "Where can you hand work over?", "start": { "radiusKm": 10 } },
          "client": { "question": "Where do you live?", "hint": "Your neighbourhood and town, never your door.", "start": { "radiusKm": 1 } }
        }
      }
    },
    "meet": {
      "piece": "date",
      "several": true,
      "when": { "handover": ["in-person"] },
      "ask": { "label": "Free to meet", "question": "When are you free to meet?", "start": { "way": "weekly", "hours": true }, "as": { "client": { "start": { "way": "day" } } } }
    },
    "shipsTo": { "piece": "choice", "values": "countries", "several": true, "roles": ["knitter"], "when": { "handover": ["shipped"] }, "ask": { "label": "Ships to", "question": "Where do you ship to?" } },
    "languages": { "piece": "choice", "values": "languages", "several": true, "ask": { "label": "Languages", "question": "Which languages do you speak?" } },
    "photos": { "piece": "photo", "several": true, "roles": ["knitter"], "ask": { "label": "Photos", "question": "Photos of work you have done" } },
    "shop": { "piece": "link", "roles": ["knitter"], "ask": { "label": "Shop", "question": "Where can people see more of your work?" } }
  },
  "preview": ["kind", "photos", "price"],
  "review": {
    "onTime": { "piece": "choice", "values": ["yes", "no"], "roles": ["knitter"], "ask": { "label": "On time", "question": "Did it come by the day agreed?" } },
    "daysLate": { "piece": "number", "unit": "days", "roles": ["knitter"], "when": { "onTime": ["no"] }, "ask": { "label": "Days late", "question": "How many days late did it come?" } },
    "paid": { "piece": "choice", "values": ["yes", "no"], "roles": ["client"], "ask": { "question": "Did they pay as agreed?" } },
    "again": { "piece": "choice", "values": ["yes", "no"] }
  }
}
