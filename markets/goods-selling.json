{
  "name": "goods-selling",
  "summary": "Buy and sell everyday things, new or used.",
  "description": "Selling, not renting; not motor vehicles or homes. If it has to be shipped, keep to things you could afford to lose.",
  "status": "beta",
  "icon": "tag",
  "number": 16,
  "roles": [
    { "role": "seller", "listings": "offers" },
    { "role": "buyer", "listings": "requests" }
  ],
  "listing": {
    "description": {
      "piece": "text",
      "ask": {
        "label": "Description",
        "long": true,
        "as": {
          "seller": { "question": "What are you selling?", "hint": "Such as the brand and model, like Levi's 501 or iPhone 13 128 GB; for trousers the waist and leg, and for a bike its frame size." },
          "buyer": { "question": "What are you looking for?", "hint": "Such as the brand or model you want; for trousers the waist and leg, and for a bike its frame size." }
        }
      }
    },
    "photos": { "piece": "photo", "several": true, "roles": ["seller"], "ask": { "label": "Photos", "question": "Any photos of it?" } },
    "category": {
      "piece": "choice",
      "values": ["clothing", "electronics", "home", "garden", "sports", "books", "kids"],
      "ask": {
        "label": "Category",
        "question": "Which category?",
        "hint": "Children's clothes and shoes are clothing. Leave it out when none fits.",
        "labels": { "home": "home, furniture and appliances", "garden": "garden and tools", "sports": "sports and bikes", "books": "books, music and games", "kids": "kids and baby" }
      }
    },
    "kind": {
      "piece": "choice",
      "values": ["clothes", "shoes", "accessories"],
      "when": { "category": ["clothing"] },
      "ask": { "label": "Kind", "question": "Clothes, shoes or accessories?", "labels": { "accessories": "bags and accessories" } }
    },
    "condition": {
      "piece": "choice",
      "values": ["new", "like-new", "good", "fair", "for-parts"],
      "several": true,
      "ask": {
        "label": "Condition",
        "hint": "Good shows light wear, fair shows clear wear, and for parts does not work.",
        "as": { "seller": { "question": "What condition is it in?" }, "buyer": { "question": "Which conditions would you take?" } }
      }
    },
    "price": {
      "piece": "price",
      "ask": {
        "label": "Price",
        "as": {
          "seller": { "question": "What is your price?", "hint": "The item alone, without shipping." },
          "buyer": { "label": "Budget", "question": "What would you pay at most?", "hint": "The item alone, without shipping." }
        }
      }
    },
    "wearer": {
      "piece": "choice",
      "values": ["women", "men", "children"],
      "several": true,
      "when": { "kind": ["clothes", "shoes"] },
      "ask": { "label": "Made for", "as": { "seller": { "question": "Who is it made for?" }, "buyer": { "question": "Who is it for?" } } }
    },
    "size": {
      "piece": "choice",
      "values": ["xxs", "xs", "s", "m", "l", "xl", "xxl", "3xl", "4xl", "one-size"],
      "several": true,
      "when": { "kind": ["clothes"] },
      "ask": {
        "label": "Size",
        "labels": { "xxs": "XXS", "xs": "XS", "s": "S", "m": "M", "l": "L", "xl": "XL", "xxl": "XXL", "3xl": "3XL", "4xl": "4XL" },
        "as": { "seller": { "question": "What size is it?" }, "buyer": { "question": "Which sizes?" } }
      }
    },
    "age": {
      "piece": "choice",
      "values": ["0-3m", "3-6m", "6-9m", "9-12m", "12-18m", "18-24m", "2-3y", "3-4y", "4-5y", "5-6y", "6-7y", "7-8y", "8-9y", "9-10y", "10-11y", "11-12y", "12-13y", "13-14y", "14-15y", "15-16y"],
      "several": true,
      "when": { "kind": ["clothes"], "wearer": ["children"] },
      "ask": {
        "label": "Child's age",
        "labels": {
          "0-3m": "0-3 months",
          "3-6m": "3-6 months",
          "6-9m": "6-9 months",
          "9-12m": "9-12 months",
          "12-18m": "12-18 months",
          "18-24m": "18-24 months",
          "2-3y": "2-3 years",
          "3-4y": "3-4 years",
          "4-5y": "4-5 years",
          "5-6y": "5-6 years",
          "6-7y": "6-7 years",
          "7-8y": "7-8 years",
          "8-9y": "8-9 years",
          "9-10y": "9-10 years",
          "10-11y": "10-11 years",
          "11-12y": "11-12 years",
          "12-13y": "12-13 years",
          "13-14y": "13-14 years",
          "14-15y": "14-15 years",
          "15-16y": "15-16 years"
        },
        "as": { "seller": { "question": "What age is it for?" }, "buyer": { "question": "Which ages?" } }
      }
    },
    "footLength": {
      "piece": "number",
      "unit": "centimetres",
      "when": { "kind": ["shoes"] },
      "ask": {
        "label": "Foot length",
        "hint": "The CM size on the label, such as 26.5.",
        "as": { "seller": { "question": "What foot length is it for?" }, "buyer": { "question": "Which foot lengths?", "start": { "range": true } } }
      }
    },
    "handover": { "piece": "choice", "values": ["in-person", "shipped"], "several": true, "ask": { "label": "In person or shipped", "question": "In person or shipped?" } },
    "area": {
      "piece": "place",
      "several": true,
      "when": { "handover": ["in-person"] },
      "ask": {
        "label": "Area",
        "hint": "Your neighbourhood and town, not your address.",
        "as": { "seller": { "question": "Where is it?", "start": { "radiusKm": 2 } }, "buyer": { "question": "Where can you pick it up?", "start": { "radiusKm": 5 } } }
      }
    },
    "shipTo": {
      "piece": "choice",
      "values": "countries",
      "several": true,
      "when": { "handover": ["shipped"] },
      "ask": {
        "label": "Ships to",
        "as": { "seller": { "question": "Which countries do you ship to?", "hint": "Leave it empty to ship anywhere." }, "buyer": { "label": "Ship to", "question": "Where should it be shipped?" } }
      }
    }
  },
  "preview": ["photos", "category", "kind", "condition", "price", "wearer", "size", "age", "footLength", "area"]
}
