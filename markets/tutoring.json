{
  "name": "tutoring",
  "summary": "Tutors teach school subjects, languages, chess and other desk subjects.",
  "description": "School subjects, languages and chess; sport and fitness are sports-coaching, and practising a language for free is language-exchange. The student is whoever arranges the lessons, often a parent, who stays present for a child's lesson in person.",
  "status": "beta",
  "icon": "graduation-cap",
  "number": 12,
  "roles": [
    { "role": "tutor", "listings": "offers" },
    { "role": "student", "listings": "requests" }
  ],
  "listing": {
    "subjects": {
      "piece": "choice",
      "values": ["maths", "physics", "chemistry", "biology", "languages", "history", "geography", "economics", "accounting", "computer-science", "philosophy", "chess"],
      "several": true,
      "ask": { "label": "Subjects", "as": { "tutor": { "question": "What do you teach?" }, "student": { "question": "Which subjects?" } } }
    },
    "taughtLanguages": {
      "piece": "choice",
      "values": "languages",
      "several": true,
      "when": { "subjects": ["languages"] },
      "ask": { "label": "Languages taught", "as": { "tutor": { "question": "Which languages do you teach?" }, "student": { "question": "Which languages?" } } }
    },
    "levels": {
      "piece": "choice",
      "values": ["primary", "secondary", "university", "adult"],
      "several": true,
      "ask": {
        "label": "Level",
        "labels": { "primary": "primary school", "secondary": "secondary school", "adult": "adults" },
        "as": { "tutor": { "question": "Which levels do you teach?" }, "student": { "question": "What level is it for?" } }
      }
    },
    "mode": {
      "piece": "choice",
      "values": ["in-person", "online"],
      "several": true,
      "ask": { "label": "Online or in person", "as": { "tutor": { "question": "Do you teach online or in person?" }, "student": { "question": "Online or in person?" } } }
    },
    "area": {
      "piece": "place",
      "several": true,
      "when": { "mode": ["in-person"] },
      "ask": {
        "label": "Area",
        "as": {
          "tutor": { "question": "Where do you teach in person?", "start": { "radiusKm": 5 } },
          "student": { "question": "Where should the lessons be?", "hint": "Your neighbourhood and town, not your address.", "start": { "radiusKm": 2 } }
        }
      }
    },
    "price": {
      "piece": "price",
      "per": ["hour", "month"],
      "ask": {
        "label": "Price",
        "as": {
          "tutor": { "question": "What do you charge?", "hint": "Such as 20 an hour, or 15 for 45 minutes. For a month, say in its note how many lessons." },
          "student": { "label": "Budget", "question": "What would you pay at most?", "hint": "Such as 15 for 45 minutes, which also says how long a lesson is." }
        }
      }
    },
    "days": {
      "piece": "date",
      "several": true,
      "ask": {
        "label": "Days and times",
        "start": { "way": "weekly", "hours": true },
        "as": { "tutor": { "question": "When do you teach?" }, "student": { "question": "When can the lessons be?" } }
      }
    },
    "languages": { "piece": "choice", "values": "languages", "several": true, "ask": { "label": "Languages", "question": "Which languages do you speak?" } },
    "description": {
      "piece": "text",
      "ask": { "label": "About", "long": true, "as": { "tutor": { "question": "What should students know?" }, "student": { "question": "What should the tutor know?" } } }
    }
  },
  "preview": ["subjects", "taughtLanguages", "levels", "mode", "area", "price"],
  "review": {
    "paid": { "piece": "choice", "values": ["yes", "no"], "roles": ["student"], "ask": { "label": "Paid", "question": "Did they pay as agreed?" } }
  }
}
