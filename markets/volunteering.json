{
  "name": "volunteering",
  "summary": "Give your time to a cause, or find volunteers for yours.",
  "description": "For adults only, online too, and never caring for children or for people who need care. A bed for help is stays-work.",
  "status": "beta",
  "icon": "hand-heart",
  "number": 14,
  "roles": [
    { "role": "organizer", "listings": "offers" },
    { "role": "volunteer", "listings": "requests" }
  ],
  "listing": {
    "description": {
      "piece": "text",
      "ask": {
        "label": "Description",
        "long": true,
        "as": {
          "organizer": { "question": "What should a volunteer know before writing to you?", "hint": "Such as the cause, how many hours a week, for help that goes on, and the languages volunteers should speak." },
          "volunteer": { "question": "What should an organizer know before writing to you?", "hint": "Such as how many hours a week you can give, and the languages you speak." }
        }
      }
    },
    "help": {
      "piece": "choice",
      "values": ["cleanup", "food", "events", "nature", "animals", "translation", "writing", "design", "digital-work"],
      "several": true,
      "ask": {
        "label": "Help",
        "labels": {
          "cleanup": "litter cleanups",
          "food": "food banks and meals",
          "events": "community events",
          "nature": "trees, land and wildlife",
          "animals": "animal shelters and rescues",
          "digital-work": "websites, social media and data"
        },
        "as": { "organizer": { "question": "What help do you need?" }, "volunteer": { "question": "What help can you give?" } }
      }
    },
    "mode": {
      "piece": "choice",
      "values": ["in-person", "online"],
      "several": true,
      "ask": { "label": "Online or in person", "as": { "organizer": { "question": "Is it online or in person?" }, "volunteer": { "question": "Online or in person?" } } }
    },
    "area": {
      "piece": "place",
      "several": true,
      "when": { "mode": ["in-person"] },
      "ask": {
        "label": "Area",
        "as": {
          "organizer": { "label": "Meeting point", "question": "Where do volunteers meet?", "hint": "A public spot, such as a park gate or a food bank.", "start": { "radiusKm": 0 } },
          "volunteer": { "question": "Where can you help?", "hint": "Your neighbourhood and town, not your address.", "start": { "radiusKm": 5 } }
        }
      }
    },
    "days": {
      "piece": "date",
      "several": true,
      "ask": {
        "label": "Days and times",
        "as": { "organizer": { "question": "When is it?", "start": { "way": "day", "hours": true } }, "volunteer": { "question": "When are you free?", "start": { "way": "weekly", "hours": true } } }
      }
    },
    "spots": {
      "piece": "number",
      "ask": {
        "label": "Volunteers",
        "as": { "organizer": { "question": "How many volunteers can come?", "hint": "Your limit, such as 30." }, "volunteer": { "question": "How many of you are coming?" } }
      }
    },
    "languages": {
      "piece": "choice",
      "values": "languages",
      "several": true,
      "when": { "help": ["translation"] },
      "ask": { "label": "Languages", "as": { "organizer": { "question": "Which languages is it from and into?" }, "volunteer": { "question": "Which languages can you translate?" } } }
    },
    "photos": { "piece": "photo", "several": true, "roles": ["organizer"], "ask": { "label": "Photos", "question": "Any photos of the place or past help?" } }
  },
  "preview": ["help", "mode", "area", "days", "photos"]
}
