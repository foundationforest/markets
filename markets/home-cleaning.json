{
  "name": "home-cleaning",
  "summary": "Cleaners clean people's homes.",
  "status": "beta",
  "icon": "broom",
  "number": 5,
  "roles": [
    { "role": "cleaner", "listings": "offers" },
    { "role": "client", "listings": "requests" }
  ],
  "listing": {
    "jobs": {
      "piece": "choice",
      "values": ["regular-cleaning", "deep-cleaning", "moving-out", "ironing", "laundry", "windows"],
      "several": true,
      "ask": { "label": "Jobs", "as": { "cleaner": { "question": "What do you do?" }, "client": { "question": "What needs doing?" } } }
    },
    "area": {
      "piece": "place",
      "ask": {
        "label": "Area",
        "as": {
          "cleaner": { "question": "Where do you work?" },
          "client": { "question": "Where is your home?", "hint": "Your neighbourhood and town, not your address.", "start": { "radiusKm": 1 } }
        }
      }
    },
    "days": {
      "piece": "date",
      "several": true,
      "ask": {
        "label": "Days and times",
        "start": { "way": "weekly", "hours": true },
        "as": { "cleaner": { "question": "When do you work?" }, "client": { "question": "When should they come?", "start": { "way": "day", "hours": true } } }
      }
    },
    "price": {
      "piece": "price",
      "per": ["hour", "visit"],
      "ask": { "label": "Price", "as": { "cleaner": { "question": "What do you charge?" }, "client": { "question": "What would you pay at most?" } } }
    },
    "frequency": {
      "piece": "choice",
      "values": ["once", "weekly", "every-two-weeks", "monthly"],
      "several": true,
      "ask": { "label": "How often", "as": { "cleaner": { "question": "How often can you come?" }, "client": { "question": "How often should they come?" } } }
    },
    "visitHours": {
      "piece": "number",
      "unit": "hours",
      "ask": { "label": "Visit length", "as": { "cleaner": { "question": "How long is a visit?", "start": { "range": true } }, "client": { "question": "How long should it take?" } } }
    },
    "bedrooms": { "piece": "number", "roles": ["client"], "ask": { "label": "Bedrooms", "question": "How many bedrooms?" } },
    "bathrooms": { "piece": "number", "roles": ["client"], "ask": { "label": "Bathrooms", "question": "How many bathrooms?" } },
    "supplies": {
      "piece": "choice",
      "values": ["cleaner", "client"],
      "ask": { "label": "Supplies", "question": "Who brings the cleaning supplies?", "labels": { "cleaner": "The cleaner", "client": "The client" } }
    },
    "pets": { "piece": "choice", "values": ["none", "dogs", "cats", "others"], "several": true, "roles": ["client"], "ask": { "label": "Pets", "question": "Any pets at home?" } },
    "languages": { "piece": "choice", "values": "languages", "several": true, "ask": { "label": "Languages", "question": "Which languages do you speak?" } },
    "description": {
      "piece": "text",
      "ask": { "label": "About", "long": true, "as": { "cleaner": { "question": "What should clients know?" }, "client": { "question": "What should the cleaner know?" } } }
    }
  },
  "preview": ["jobs", "area", "days", "price"],
  "review": {
    "onTime": { "piece": "choice", "values": ["yes", "no"], "roles": ["cleaner"], "ask": { "label": "On time", "question": "Did they come at the time agreed?" } },
    "paid": { "piece": "choice", "values": ["yes", "no"], "roles": ["client"], "ask": { "label": "Paid", "question": "Did they pay as agreed?" } }
  }
}
