{
  "name": "home-cleaning",
  "summary": "Cleaners clean people's homes.",
  "status": "beta",
  "icon": "broom",
  "number": 5,
  "roles": [
    { "role": "cleaner", "listings": "offers" },
    { "role": "client", "listings": "requests" }
  ],
  "listing": {
    "jobs": {
      "piece": "choice",
      "values": ["regular-cleaning", "deep-cleaning", "moving-out", "ironing", "laundry", "windows"],
      "several": true,
      "ask": { "label": "Jobs", "as": { "cleaner": { "question": "What do you do?" }, "client": { "question": "What needs doing?" } } }
    },
    "area": {
      "piece": "place",
      "several": true,
      "ask": {
        "label": "Area",
        "as": {
          "cleaner": { "question": "Where do you work?", "start": { "radiusKm": 10 } },
          "client": { "question": "Where is your home?", "hint": "Your neighbourhood and town, not your address.", "start": { "radiusKm": 1 } }
        }
      }
    },
    "days": {
      "piece": "date",
      "several": true,
      "ask": {
        "label": "Days and times",
        "start": { "way": "weekly", "hours": true },
        "as": { "cleaner": { "question": "When do you work?" }, "client": { "question": "When should they come?", "start": { "way": "day", "hours": "part" } } }
      }
    },
    "price": {
      "piece": "price",
      "per": ["hour", "day"],
      "ask": {
        "label": "Price",
        "as": {
          "cleaner": { "question": "What do you charge?", "hint": "Such as 15 an hour. A minimum, such as at least 2 hours, goes in its note." },
          "client": { "label": "Budget", "question": "What would you pay at most?", "hint": "Such as 60 for 3 hours, which also says how long the job is." }
        }
      }
    },
    "bringsSupplies": { "piece": "choice", "values": ["yes", "no"], "roles": ["cleaner"], "ask": { "label": "Brings supplies", "question": "Do you bring your own supplies?" } },
    "needsSupplies": { "piece": "choice", "values": ["yes", "no"], "roles": ["client"], "ask": { "label": "Bring supplies", "question": "Should the cleaner bring supplies?" } },
    "description": {
      "piece": "text",
      "ask": {
        "label": "About",
        "long": true,
        "as": {
          "cleaner": { "question": "What should clients know?", "hint": "Such as how often you can come, whether you mind pets, and the languages you speak." },
          "client": { "question": "What should the cleaner know?", "hint": "Such as how often, how big the home is, any pets, and the languages you speak." }
        }
      }
    }
  },
  "preview": ["jobs", "area", "days", "price"],
  "review": {
    "onTime": { "piece": "choice", "values": ["yes", "no"], "roles": ["cleaner"], "ask": { "label": "On time", "question": "Did they come at the time agreed?" } },
    "paid": { "piece": "choice", "values": ["yes", "no"], "roles": ["client"], "ask": { "label": "Paid", "question": "Did they pay as agreed?" } }
  }
}
